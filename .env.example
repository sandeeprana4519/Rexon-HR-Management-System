# ============================================================================
# REXON HR MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and supply your Firebase Web App credentials.
# Never commit real `.env` secrets to version control.
# ============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================================
# SERVER-SIDE ONLY — PRIVILEGED HR ACCOUNT CREATION (NEVER PREFIX WITH VITE_)
# Used by server.ts / Cloud Functions so Firebase Admin credentials are never
# exposed in frontend client bundles.
# ============================================================================
FIREBASE_PROVISION_FUNCTION_URL=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Platform runtime variables (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
