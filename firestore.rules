        && data.shiftType is string && data.shiftType.size() >= 2 && data.shiftType.size() <= 80
        && data.scheduledStartTime is string && data.scheduledStartTime.size() == 5
        && data.scheduledEndTime is string && data.scheduledEndTime.size() == 5
        && data.crossesMidnight is bool
