          'checkInAt', 'checkOutAt', 'checkInMethod', 'checkOutMethod',
          'checkInGeo', 'checkOutGeo', 'qrSessionId', 'qrVerificationStatus', 'deviceMetadata',
          'totalGrossMinutes', 'totalDutyMinutes', 'totalDutyHours',
          'lateArrivalMinutes', 'earlyDepartureMinutes', 'overtimeMinutes',
          'overtimeStatus', 'approvedOvertimeMinutes', 'overtimeApprovedBy', 'overtimeApprovedAt',
