    function isValidSiteAttendanceSummaryPayload(data, summaryId) {
      return data.keys().hasAll([
          'summaryId', 'siteId', 'siteName', 'clientId', 'clientName', 'branchId',
          'attendanceDate', 'totalSanctioned', 'totalDeployed',
          'presentCount', 'lateCount', 'halfDayCount', 'absentCount',
          'weeklyOffCount', 'leaveCount', 'pendingCount',
          'serviceBreakdown', 'shiftBreakdown', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'summaryId', 'siteId', 'siteName', 'clientId', 'clientName', 'branchId',
          'attendanceDate', 'totalSanctioned', 'totalDeployed',
          'presentCount', 'lateCount', 'halfDayCount', 'absentCount',
          'weeklyOffCount', 'leaveCount', 'pendingCount',
          'serviceBreakdown', 'shiftBreakdown', 'updatedAt', 'serverUpdatedAt'
        ])
        // Strictly block employee PII, KYC, salary, and GPS coordinates in Site Portal summary
        && !('employees' in data)
        && !('employeeNames' in data)
        && !('employeeName' in data)
        && !('mobile' in data)
        && !('phone' in data)
        && !('aadhaarNumber' in data)
        && !('panNumber' in data)
        && !('bankAccountNumber' in data)
        && !('basicSalary' in data)
        && !('latitude' in data)
        && !('longitude' in data)
        && !('checkInGeo' in data)
