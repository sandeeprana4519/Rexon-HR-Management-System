rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // 0. Global Default-Deny Safety Net
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // 1. Core Security Primitives & RBAC Helpers
    //    Never trust client-supplied roles; verify against users/{request.auth.uid}
    //    or verified bootstrapped owner email.
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'sandeeprana4519@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasActiveProfile() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.isActive == true;
    }

    function callerData() {
      return get(userDocPath()).data;
    }

    function hasRole(targetRole) {
      return hasActiveProfile() && callerData().role == targetRole;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || hasRole('admin');
    }

    function isHR() {
      return hasRole('hr');
    }

    function isFieldOfficer() {
      return hasRole('field_officer');
    }

    function isSiteManager() {
      return hasRole('site');
    }

    function isEmployee() {
      return hasRole('employee');
    }

    function isAuthorizedForBranch(branchId) {
      return isAdmin()
        || (
          isHR()
          && (
            callerData().branchId == branchId
            || ('assignedBranches' in callerData() && branchId in callerData().assignedBranches)
          )
        );
    }

    function isAuthorizedForAttendanceBranch(branchId) {
      return isAuthorizedForBranch(branchId)
        || (isHR() && 'attendance.view_all_branch' in callerData().permissions);
    }

    function isAuthorizedFieldOfficerBranch(branchId) {
      return isFieldOfficer()
        && (
          callerData().branchId == branchId
          || ('assignedBranches' in callerData() && branchId in callerData().assignedBranches)
        );
    }

    function hasPermission(perm) {
      return isAdmin() || (isHR() && perm in callerData().permissions);
    }

    function hasAnyPermission(perms) {
      return isAdmin() || (isHR() && callerData().permissions.hasAny(perms));
    }

    function isAssignedToSite(siteId) {
      return isAdmin()
        || (isHR() && siteId in callerData().assignedSiteIds)
        || (isFieldOfficer() && siteId in callerData().assignedSiteIds)
        || (isSiteManager() && siteId in callerData().assignedSiteIds);
    }

    // ------------------------------------------------------------------------
    // 2. Schema Validation Helpers (Anti-Update-Gap & Size Bounds)
    // ------------------------------------------------------------------------
    function isValidRoleValue(role) {
      return role in ['admin', 'hr', 'field_officer', 'site', 'employee'];
    }

    function isValidServiceCategory(cat) {
      return cat in ['Security', 'Housekeeping', 'Manpower'];
    }

    function isValidBoundedStringArray(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    function isValidUserPayload(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'fullName', 'email', 'phone', 'role',
          'branchId', 'assignedSiteIds', 'permissions',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && data.uid == targetUid
        && data.uid is string && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && isValidRoleValue(data.role)
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && (!('assignedBranches' in data) || isValidBoundedStringArray(data.assignedBranches, 25))
        && isValidBoundedStringArray(data.assignedSiteIds, 50)
        && isValidBoundedStringArray(data.permissions, 60)
        && data.isActive is bool;
    }

    function isValidBranchPayload(data, branchId) {
      return data.keys().hasAll([
          'branchId', 'branchName', 'branchCode', 'managerName',
          'mobile', 'email', 'address', 'city', 'state', 'pinCode',
          'status', 'createdDate', 'updatedAt', 'isDeleted'
        ])
        && data.branchId == branchId
        && data.branchName is string && data.branchName.size() >= 3 && data.branchName.size() <= 120
        && data.branchCode is string && data.branchCode.size() >= 2 && data.branchCode.size() <= 24
        && data.managerName is string && data.managerName.size() >= 2 && data.managerName.size() <= 100
        && data.mobile is string && data.mobile.size() >= 7 && data.mobile.size() <= 20
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 250
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.pinCode is string && data.pinCode.size() == 6
        && data.status in ['Active', 'Inactive']
        && data.isDeleted is bool;
    }

    function isValidHRProfilePayload(data, hrId) {
      return data.keys().hasAll([
          'hrId', 'uid', 'fullName', 'email', 'mobile',
          'assignedBranches', 'hrDesignation', 'permissionProfile',
          'permissions', 'joiningDate', 'accountStatus', 'createdAt', 'updatedAt'
        ])
        && !('password' in data)
        && data.hrId == hrId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.mobile is string && data.mobile.size() >= 7 && data.mobile.size() <= 20
        && isValidBoundedStringArray(data.assignedBranches, 25)
        && isValidBoundedStringArray(data.permissions, 60)
        && data.hrDesignation in ['Senior HR', 'Branch HR', 'Site HR', 'HR Executive', 'Accountant']
        && data.permissionProfile is string && data.permissionProfile.size() >= 2 && data.permissionProfile.size() <= 80
        && data.accountStatus in ['Active', 'Inactive', 'Suspended'];
    }

    function isValidClientPayload(data, clientId) {
      return data.keys().hasAll([
          'clientId', 'companyName', 'displayName', 'companyType',
          'gstNumber', 'panNumber', 'registeredAddress', 'state', 'city', 'pinCode',
          'contactPerson', 'contactDesignation', 'mobile', 'email',
          'billingAddress', 'billingContact', 'contractStartDate', 'contractEndDate',
          'paymentTerms', 'assignedBranch', 'clientStatus', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.clientId == clientId
        && data.companyName is string && data.companyName.size() >= 3 && data.companyName.size() <= 150
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100
        && data.panNumber is string && data.panNumber.size() == 10
        && data.assignedBranch is string && data.assignedBranch.size() >= 1 && data.assignedBranch.size() <= 64
        && data.clientStatus in ['Active', 'Inactive', 'On Hold', 'Expired'];
    }

    function isValidSitePayload(data, siteId) {
      return data.keys().hasAll([
          'siteId', 'siteName', 'clientId', 'clientName', 'branchId',
          'siteType', 'fullAddress', 'city', 'state', 'pinCode',
          'siteContactPerson', 'siteManagerName', 'managerMobile', 'managerEmail',
          'startDate', 'contractEndDate', 'siteStatus', 'isArchived', 'createdAt', 'updatedAt'
        ])
        && data.siteId == siteId
        && data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 64
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 150
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && data.siteName is string && data.siteName.size() >= 3 && data.siteName.size() <= 140
        && data.siteStatus in ['Active', 'Inactive', 'Pending', 'Suspended']
        && (!('latitude' in data) || data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && (!('allowedRadiusMeters' in data) || (data.allowedRadiusMeters is int && data.allowedRadiusMeters >= 20 && data.allowedRadiusMeters <= 5000))
        && (!('gpsAccuracyThresholdMeters' in data) || (data.gpsAccuracyThresholdMeters is int && data.gpsAccuracyThresholdMeters >= 10 && data.gpsAccuracyThresholdMeters <= 1000))
        && (!('isGpsMandatory' in data) || data.isGpsMandatory is bool)
        && (!('isQrEnabled' in data) || data.isQrEnabled is bool)
        && data.isArchived is bool;
    }

    function isValidServicePayload(data, serviceId) {
      return data.keys().hasAll([
          'serviceId', 'serviceName', 'serviceCategory', 'serviceCode',
          'description', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'serviceId', 'serviceName', 'serviceCategory', 'serviceCode',
          'description', 'status', 'createdBy', 'createdAt', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.serviceId == serviceId
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 100
        && isValidServiceCategory(data.serviceCategory)
        && data.serviceCode is string && data.serviceCode.size() >= 2 && data.serviceCode.size() <= 24
        && data.description is string && data.description.size() <= 300
        && data.status in ['Active', 'Inactive']
        && data.createdBy is string && data.createdBy.size() <= 160
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidDesignationPayload(data, designationId) {
      return data.keys().hasAll([
          'designationId', 'designationName', 'serviceCategory',
          'relatedServiceId', 'relatedServiceName', 'description',
          'requiredSkills', 'qualification', 'trainingRequirements',
          'licenseRequirements', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'designationId', 'designationName', 'serviceCategory',
          'relatedServiceId', 'relatedServiceName', 'description',
          'requiredSkills', 'qualification', 'trainingRequirements',
          'licenseRequirements', 'status', 'createdBy', 'createdAt', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.designationId == designationId
        && data.designationName is string && data.designationName.size() >= 2 && data.designationName.size() <= 100
        && isValidServiceCategory(data.serviceCategory)
        && data.relatedServiceId is string && data.relatedServiceId.size() >= 1 && data.relatedServiceId.size() <= 64
        && data.relatedServiceName is string && data.relatedServiceName.size() >= 2 && data.relatedServiceName.size() <= 100
        && data.description is string && data.description.size() <= 300
        && data.requiredSkills is string && data.requiredSkills.size() <= 250
        && data.qualification is string && data.qualification.size() <= 160
        && data.trainingRequirements is string && data.trainingRequirements.size() <= 200
        && data.licenseRequirements is string && data.licenseRequirements.size() <= 200
        && data.status in ['Active', 'Inactive']
        && data.createdBy is string && data.createdBy.size() <= 160
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidSiteServicePayload(data, siteServiceId) {
      return data.keys().hasAll([
          'siteServiceId', 'siteId', 'siteName', 'clientId', 'branchId',
          'serviceCategory', 'serviceId', 'serviceName', 'designationId', 'designationName',
          'requiredCount', 'deployedCount', 'vacantCount',
          'shiftType', 'workingHours', 'weeklyOff',
          'serviceStartDate', 'serviceEndDate', 'notes',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'siteServiceId', 'siteId', 'siteName', 'clientId', 'branchId',
          'serviceCategory', 'serviceId', 'serviceName', 'designationId', 'designationName',
          'requiredCount', 'deployedCount', 'vacantCount',
          'shiftType', 'workingHours', 'weeklyOff',
          'serviceStartDate', 'serviceEndDate', 'notes',
          'status', 'createdBy', 'createdAt', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.siteServiceId == siteServiceId
        && data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 64
        && data.siteName is string && data.siteName.size() >= 2 && data.siteName.size() <= 140
        && data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 64
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && isValidServiceCategory(data.serviceCategory)
        && data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 64
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 100
        && data.designationId is string && data.designationId.size() >= 1 && data.designationId.size() <= 64
        && data.designationName is string && data.designationName.size() >= 2 && data.designationName.size() <= 100
        // Strict Non-Negative Vacancy Invariant: Vacant = Required - Deployed >= 0
        && data.requiredCount is int && data.requiredCount >= 1 && data.requiredCount <= 10000
        && data.deployedCount is int && data.deployedCount >= 0 && data.deployedCount <= data.requiredCount
        && data.vacantCount is int && data.vacantCount >= 0
        && data.vacantCount == data.requiredCount - data.deployedCount
        && data.shiftType is string && data.shiftType.size() >= 2 && data.shiftType.size() <= 60
        && data.workingHours is string && data.workingHours.size() >= 2 && data.workingHours.size() <= 40
        && data.weeklyOff is string && data.weeklyOff.size() >= 2 && data.weeklyOff.size() <= 60
        && data.serviceStartDate is string && data.serviceStartDate.size() <= 32
        && data.serviceEndDate is string && data.serviceEndDate.size() <= 32
        && data.notes is string && data.notes.size() <= 300
        && data.status in ['Active', 'Inactive']
        && data.createdBy is string && data.createdBy.size() <= 160
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidApprovalPayload(data, approvalId) {
      return data.keys().hasAll([
          'approvalId', 'requestType', 'module', 'targetRecordId', 'targetRecordName',
          'branchId', 'requestedByUid', 'requestedByName', 'requestedByRole',
          'summary', 'reason', 'status', 'reviewedByUid', 'reviewedByName',
          'reviewRemarks', 'createdAt', 'updatedAt', 'decidedAt'
        ])
        && data.keys().hasOnly([
          'approvalId', 'requestType', 'module', 'targetRecordId', 'targetRecordName',
          'branchId', 'requestedByUid', 'requestedByName', 'requestedByRole',
          'summary', 'reason', 'proposedPayload', 'status', 'reviewedByUid',
          'reviewedByName', 'reviewRemarks', 'createdAt', 'updatedAt', 'decidedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.approvalId == approvalId
        && data.requestType in [
          'Site Deletion',
          'Client Deletion',
          'Client Sensitive Change',
          'Employee Deletion',
          'Employee Sensitive Change',
          'Site Sanctioned Strength Override',
          'Permission Change Request',
          'Branch Scope Exception',
          'Field Officer Replacement Request',
          'Field Officer Transfer Request',
          'Manpower Shortage Escalation',
          'Roster Capacity Exception',
          'Attendance Correction Approval',
          'Overtime Approval Request'
        ]
        && data.module in [
          'Client', 'Site', 'Employee', 'Permissions', 'Branch', 'Service',
          'Designation', 'Assignment', 'Roster', 'Attendance'
        ]
        && data.targetRecordId is string && data.targetRecordId.size() >= 1 && data.targetRecordId.size() <= 64
        && data.targetRecordName is string && data.targetRecordName.size() >= 1 && data.targetRecordName.size() <= 140
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && data.requestedByUid is string && data.requestedByUid.size() >= 1 && data.requestedByUid.size() <= 128
        && data.requestedByName is string && data.requestedByName.size() >= 2 && data.requestedByName.size() <= 120
        && isValidRoleValue(data.requestedByRole)
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 220
        && data.reason is string && data.reason.size() >= 8 && data.reason.size() <= 400
        && data.status in ['Pending', 'Approved', 'Rejected', 'Cancelled']
        && (data.reviewedByUid == null || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128))
        && (data.reviewedByName == null || (data.reviewedByName is string && data.reviewedByName.size() <= 120))
        && data.reviewRemarks is string && data.reviewRemarks.size() <= 300
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (data.decidedAt == null || (data.decidedAt is string && data.decidedAt.size() <= 40));
    }

    function isValidPhase2AuditLogPayload(data) {
      return data.keys().hasAll([
          'logId', 'action', 'module', 'recordId', 'performedBy',
          'actorUid', 'role', 'branchId', 'timestamp', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'logId', 'action', 'module', 'recordId', 'performedBy',
          'actorUid', 'role', 'branchId', 'timestamp', 'summary', 'createdAt'
        ])
        && data.logId is string && data.logId.size() >= 3 && data.logId.size() <= 64
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 120
        && data.module in [
          'Branch', 'HR', 'Client', 'Site', 'Employee', 'SiteService',
          'Service', 'Designation', 'Permissions', 'Approvals', 'Assignment',
          'Roster', 'Attendance'
        ]
        && data.recordId is string && data.recordId.size() >= 1 && data.recordId.size() <= 64
        && data.performedBy is string && data.performedBy.size() >= 2 && data.performedBy.size() <= 200
        && data.actorUid == request.auth.uid
        && isValidRoleValue(data.role)
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && data.timestamp is string && data.timestamp.size() <= 40
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400
        && data.createdAt == request.time;
    }

    function isValidLegacyAuditLogPayload(data) {
      return data.keys().hasAll(['actorUid', 'actorRole', 'action', 'targetPath', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorRole', 'action', 'targetPath', 'branchId', 'createdAt'])
        && data.actorUid == request.auth.uid
        && data.actorRole is string && data.actorRole.size() <= 32
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 120
        && data.targetPath is string && data.targetPath.size() >= 1 && data.targetPath.size() <= 200
        && (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 64))
        && data.createdAt == request.time;
    }

    function isValidAuditLogPayload(data) {
      return isValidPhase2AuditLogPayload(data) || isValidLegacyAuditLogPayload(data);
    }

    function isValidEmployeePayload(data, employeeId) {
      return data.keys().hasAll([
          'employeeId', 'fullName', 'dateOfBirth', 'gender', 'mobile',
          'joiningDate', 'branchId', 'employmentType', 'employeeStatus',
          'assignedServiceCategories', 'assignedDesignationIds', 'assignedDesignations',
          'docVerificationSummary', 'isActive', 'isDeleted', 'createdAt', 'updatedAt'
        ])
        // Strictly block sensitive PII & salary fields on operational employees/{employeeId}
        && !('aadhaarNumber' in data)
        && !('panNumber' in data)
        && !('bankAccountNumber' in data)
        && !('ifscCode' in data)
        && !('basicSalary' in data)
        && !('password' in data)
        && data.employeeId == employeeId
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.dateOfBirth is string && data.dateOfBirth.size() >= 8 && data.dateOfBirth.size() <= 20
        && data.gender in ['Male', 'Female', 'Other']
        && data.mobile is string && data.mobile.size() >= 7 && data.mobile.size() <= 20
        && data.joiningDate is string && data.joiningDate.size() >= 8 && data.joiningDate.size() <= 20
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && data.employmentType in ['Full-Time', 'Permanent', 'Contract', 'Part-Time', 'Temporary', 'Reliever']
        && data.employeeStatus in ['Active', 'Inactive', 'On Leave', 'Suspended', 'Exited', 'Left']
        && data.assignedDesignationIds is list && data.assignedDesignationIds.size() >= 1 && data.assignedDesignationIds.size() <= 20
        && data.assignedDesignations is list && data.assignedDesignations.size() >= 1 && data.assignedDesignations.size() <= 20
        && data.docVerificationSummary in ['No Documents', 'Pending', 'Verified', 'Rejected']
        && data.isActive is bool
        && data.isDeleted is bool;
    }

    function isValidEmployeePrivatePayload(data, employeeId) {
      return (
          ('employeeId' in data && data.employeeId == employeeId)
          || ('uid' in data && data.uid == employeeId)
        )
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && (!('salaryType' in data) || data.salaryType in ['Monthly', 'Daily', 'Hourly'])
        && (!('basicSalary' in data) || (data.basicSalary is number && data.basicSalary >= 0));
    }

    function isValidEmployeeDocumentPayload(data, documentId) {
      return data.keys().hasAll([
          'documentId', 'employeeId', 'branchId', 'documentType', 'isSensitiveKyc',
          'fileName', 'mimeType', 'fileSizeBytes', 'storagePath',
          'uploadedAt', 'uploadedByUid', 'verificationStatus', 'updatedAt'
        ])
        && data.documentId == documentId
        && data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 64
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && data.documentType in [
          'Aadhaar Document', 'PAN Document', 'Photograph', 'Address Proof',
          'Police Verification', 'Qualification Certificates', 'Training Certificates',
          'Experience Certificates', 'Bank Proof', 'Other Documents'
        ]
        && data.isSensitiveKyc is bool
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120
        && data.fileSizeBytes is int && data.fileSizeBytes > 0 && data.fileSizeBytes <= 5 * 1024 * 1024
        && data.verificationStatus in ['Pending', 'Verified', 'Rejected'];
    }

    function isValidEmployeeHistoryPayload(data, historyId) {
      return data.keys().hasAll([
          'historyId', 'employeeId', 'branchId', 'category',
          'action', 'summary', 'actorUid', 'actorRole', 'timestamp'
        ])
        && data.historyId == historyId
        && data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 64
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
        && data.category in ['Designation', 'SiteAssignment', 'Activity']
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 100
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400
        && data.actorUid == request.auth.uid
        && isValidRoleValue(data.actorRole);
    }

    function isValidEmployeeAssignmentPayload(data, assignmentId) {
      return data.keys().hasAll([
          'assignmentId', 'employeeId', 'employeeName', 'linkedUid',
          'branchId', 'branchName', 'clientId', 'clientName', 'siteId', 'siteName',
          'siteServiceId', 'serviceCategory', 'serviceId', 'serviceName',
          'designationId', 'designationName', 'shift', 'shiftStartTime', 'shiftEndTime',
          'reportingTime', 'dutyHours', 'weeklyOff', 'startDate', 'endDate',
          'reportingInstructions', 'remarks', 'assignmentStatus',
          'previousAssignmentId', 'previousSiteId', 'previousSiteName',
          'transferredToAssignmentId', 'transferredToSiteId', 'transferredToSiteName',
          'assignedBy', 'assignedByRole', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && !('aadhaarNumber' in data)
        && !('panNumber' in data)
        && !('bankAccountNumber' in data)
        && !('basicSalary' in data)
        && data.assignmentId == assignmentId
        && data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 64
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 120
        && data.linkedUid is string && data.linkedUid.size() <= 128
        && data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 64
